# ---------------------------------------------------------------------------
# EXPEDITOO — environment reference
#
# Copy to .env.local for local development. Never paste production values in:
# `pnpm dev` refuses to start against the production database, on purpose.
#
# Where each value lives
#   local      .env.local on your machine (git-ignored)
#   preview    Vercel → Preview scope        (`pnpm env:set <KEY> preview`)
#   production Vercel → Production scope     (`pnpm env:set <KEY> production`)
#
# Full contract: docs/specs/environments_spec.md
# ---------------------------------------------------------------------------

# --- Environment ------------------------------------------------------------
# local | preview | production. Optional — derived from VERCEL_ENV on Vercel,
# and anything off Vercel is "local". Set it only to pin a process.
APP_ENV=local

# Public base URL. localhost locally; the deployment URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# local      a local PostgreSQL 17 (`pnpm db:start` creates and starts it)
# preview    a Neon branch — never the production endpoint
# production the production Neon endpoint (Vercel Marketplace resource)
POSTGRES_URL=postgresql://postgres@localhost:5432/expeditoo_dev

# Direct, unpooled connection. Migrations and drizzle-kit need it: Neon's
# pooler is PgBouncer in transaction mode and is not reliable for DDL. On Neon
# this is the same host without the `-pooler` suffix.
POSTGRES_URL_NON_POOLING=postgresql://postgres@localhost:5432/expeditoo_dev

# Comma-separated Neon endpoint ids that count as development databases.
# Fail-closed: a remote database not listed here is refused by every
# destructive script. localhost is always allowed. Never list production.
DEV_DB_REFS=

# Connection pool tuning (optional; defaults 20 / 60s).
POSTGRES_POOL_MAX=20
POSTGRES_IDLE_TIMEOUT=60

# For `pnpm db:mirror` only (see docs/specs/environments_spec.md §5) — a
# different variable name than POSTGRES_URL so it can never become the app's
# own connection string by typo. Get it from the Neon dashboard → Connect →
# the direct (unpooled) connection string.
MIRROR_SOURCE_URL=
# Accounts left readable (name/email/role) in the mirror instead of scrubbed.
MIRROR_KEEP_EMAILS=

# --- Auth -------------------------------------------------------------------
# Use a DIFFERENT secret per environment: sharing it makes a preview-issued
# session cookie valid in production.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe -----------------------------------------------------------------
# local + preview: sk_test_ / pk_test_
# production:      sk_live_ / pk_live_ (asserted at boot)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cloudflare R2 ----------------------------------------------------------
# Separate buckets per environment. KYC documents are identity papers, so the
# dev bucket must never be the production one.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=expeditoo-dev
R2_KYC_BUCKET_NAME=expeditoo-kyc-dev
# Expedion bordereaux and lot photos. A bordereau carries the buyer's name,
# address, phone and the lot's declared value, so this is a PRIVATE bucket and
# must not be R2_BUCKET_NAME: the image-cleanup cron lists every object in that
# one and deletes anything it cannot match to a listing photo, which is every
# bordereau on the platform. `expedion-storage.service.ts` refuses to start
# rather than fall back to it; unset, it falls back to R2_KYC_BUCKET_NAME.
R2_EXPEDION_BUCKET_NAME=expeditoo-expedion-dev
# Pickup and delivery photos. Photographs of a client's goods standing at a
# client's address, so PRIVATE for the same reason and with the same warning:
# never R2_BUCKET_NAME. Unset, it falls back to R2_KYC_BUCKET_NAME and then to
# R2_EXPEDION_BUCKET_NAME, so a deployment that has either of those already
# works without a new value.
R2_SHIPMENT_BUCKET_NAME=expeditoo-shipments-dev
R2_PUBLIC_URL=

# --- Photo stamp ------------------------------------------------------------
# Directory holding the fonts.conf that fontconfig reads: point it anywhere
# without one and the location band burned into every pickup and delivery photo
# comes out a black bar with no letters. Leave it empty and the app points it at
# the repo's own `fonts/` (Inter, plus the config beside it), resolved from the
# working directory at runtime — which is what production uses. Set it only to
# hand rendering back to a host that has its own fonts.
FONTCONFIG_PATH=

# --- Twilio (SMS) -----------------------------------------------------------
# The Expedion bridge texts a client when their transport moves and when it
# needs their confirmation. Unset, every send is skipped and logged, never
# thrown - a bridge outage must not undo a delivery that really happened.
#
# Not registered as of 2026-09-10, so nothing is texted. Email is the channel
# that actually works: Resend is configured above and every document and
# notification goes out that way.
#
# There is deliberately no WhatsApp variable here. A sender number alone sends
# nothing - it needs a Twilio WhatsApp sender, a verified Meta Business account
# and Meta-approved templates, none of which exist. Adding the variable early
# would suggest a channel that would fail silently.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Ably -------------------------------------------------------------------
# Channel names are prefixed with the environment tag outside production, so a
# local publish cannot reach a production subscriber even on a shared key.
ABLY_API_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Expeditoo <onboarding@resend.dev>

# Outside production every recipient is rewritten to this address. Leave it
# empty to drop non-production mail entirely (still logged).
EMAIL_DEV_RECIPIENT=

# Where the public contact form (/contact) delivers. Optional — defaults to
# support@expeditoo.com. Outside production it is redirected like any other
# recipient by EMAIL_DEV_RECIPIENT above.
CONTACT_INBOX_EMAIL=

# --- Expedion bridge --------------------------------------------------------
EXPEDION_API_KEY=
EXPEDION_ADMIN_API_KEY=
EXPEDION_APP_ORIGINS=
EXPEDION_SYSTEM_USER_ID=
EXPEDION_CATEGORY_ID=
# Hours a paid, unassigned quote waits before auto-escalation. Production: 48.
EXPEDION_ESCALATE_AFTER_HOURS=48

# --- Invoicing --------------------------------------------------------------
# TODO(EXPEDITOO-LEGAL): the issuer block printed on every payment document.
# While ANY of NAME/LEGAL_FORM/ADDRESS/SIRET/RCS/VAT_RATE is unset the document
# is titled "Reçu de paiement" and footed "ne vaut pas facture"; fill them all
# and the same document becomes a conforming "Facture", with no code change and
# nothing backdated. See docs/specs/invoice_at_payment_spec.md §4.1.
INVOICE_ISSUER_NAME=
INVOICE_ISSUER_LEGAL_FORM=
INVOICE_ISSUER_CAPITAL=
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_SIRET=
INVOICE_ISSUER_RCS=
# Required only when VAT is actually charged; a business under the franchise en
# base has none.
INVOICE_ISSUER_VAT_NUMBER=
INVOICE_ISSUER_EMAIL=
# Percent. "0" is the franchise en base (art. 293 B du CGI) and is a stated
# position; leaving it empty is not, and the document says so.
INVOICE_VAT_RATE=

# --- Cron -------------------------------------------------------------------
# Shared secret for .github/workflows/scheduled-jobs.yml. Different per env.
CRON_SECRET=

# --- Testing mocks ----------------------------------------------------------
# TODO(EXPEDITOO-TESTING): skips Stripe and records authorise/capture/release
# directly. Boot fails if this is true in production. See docs/TESTING_MOCKS.md.
MOCK_PAYMENTS=true

# --- Optional ---------------------------------------------------------------
OPENAI_API_KEY=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
