# ---------------------------------------------------------------------------
# EXPEDITOO — environment reference
#
# Copy to .env.local for local development. Never paste production values in:
# `pnpm dev` refuses to start against the production database, on purpose.
#
# Where each value lives
#   local      .env.local on your machine (git-ignored)
#   preview    Vercel → Preview scope        (`pnpm env:set <KEY> preview`)
#   production Vercel → Production scope     (`pnpm env:set <KEY> production`)
#
# Full contract: docs/specs/environments_spec.md
# ---------------------------------------------------------------------------

# --- Environment ------------------------------------------------------------
# local | preview | production. Optional — derived from VERCEL_ENV on Vercel,
# and anything off Vercel is "local". Set it only to pin a process.
APP_ENV=local

# Public base URL. localhost locally; the deployment URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# local      a local PostgreSQL 17 (`pnpm db:start` creates and starts it)
# preview    the dev Supabase project — never the production one
# production the production Supabase project
POSTGRES_URL=postgresql://postgres@localhost:5432/expeditoo_dev

# Direct (session, port 5432) connection. Migrations and drizzle-kit need it,
# because Supabase's transaction pooler on 6543 cannot run their DDL.
POSTGRES_URL_NON_POOLING=postgresql://postgres@localhost:5432/expeditoo_dev

# Comma-separated Supabase project refs that count as development databases.
# Fail-closed: a remote database not listed here is refused by every
# destructive script. localhost is always allowed. Never list production.
DEV_DB_REFS=

# Connection pool tuning (optional; defaults 20 / 60s).
POSTGRES_POOL_MAX=20
POSTGRES_IDLE_TIMEOUT=60

# For `pnpm db:mirror` only (see docs/specs/environments_spec.md §5) — a
# different variable name than POSTGRES_URL so it can never become the app's
# own connection string by typo. Get it from Supabase → Project Settings →
# Database → Connection string (Session, port 5432).
MIRROR_SOURCE_URL=
# Accounts left readable (name/email/role) in the mirror instead of scrubbed.
MIRROR_KEEP_EMAILS=

# --- Auth -------------------------------------------------------------------
# Use a DIFFERENT secret per environment: sharing it makes a preview-issued
# session cookie valid in production.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe -----------------------------------------------------------------
# local + preview: sk_test_ / pk_test_
# production:      sk_live_ / pk_live_ (asserted at boot)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cloudflare R2 ----------------------------------------------------------
# Separate buckets per environment. KYC documents are identity papers, so the
# dev bucket must never be the production one.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=expeditoo-dev
R2_KYC_BUCKET_NAME=expeditoo-kyc-dev
R2_PUBLIC_URL=

# --- Ably -------------------------------------------------------------------
# Channel names are prefixed with the environment tag outside production, so a
# local publish cannot reach a production subscriber even on a shared key.
ABLY_API_KEY=
NEXT_PUBLIC_REALTIME_ENABLED=false

# --- Email ------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Expeditoo <onboarding@resend.dev>

# Outside production every recipient is rewritten to this address. Leave it
# empty to drop non-production mail entirely (still logged).
EMAIL_DEV_RECIPIENT=

# Where the public contact form (/contact) delivers. Optional — defaults to
# support@expeditoo.com. Outside production it is redirected like any other
# recipient by EMAIL_DEV_RECIPIENT above.
CONTACT_INBOX_EMAIL=

# --- Expedion bridge --------------------------------------------------------
EXPEDION_API_KEY=
EXPEDION_ADMIN_API_KEY=
EXPEDION_APP_ORIGINS=
EXPEDION_SYSTEM_USER_ID=
EXPEDION_CATEGORY_ID=
# Hours a paid, unassigned quote waits before auto-escalation. Production: 48.
EXPEDION_ESCALATE_AFTER_HOURS=48

# --- Cron -------------------------------------------------------------------
# Shared secret for .github/workflows/scheduled-jobs.yml. Different per env.
CRON_SECRET=

# --- Testing mocks ----------------------------------------------------------
# TODO(EXPEDITOO-TESTING): skips Stripe and records authorise/capture/release
# directly. Boot fails if this is true in production. See docs/TESTING_MOCKS.md.
MOCK_PAYMENTS=true

# --- Optional ---------------------------------------------------------------
OPENAI_API_KEY=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=
